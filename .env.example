# Copia a .env y rellena. Nunca subas .env al repositorio.
CUTLY_ENV=dev
CUTLY_DATA_DIR=./data
CUTLY_DATABASE_URL=sqlite:///./data/cutly.db
CUTLY_REDIS_URL=redis://localhost:6379/0
# Clave para firmar cookies de sesión (genera: python -c "import secrets;print(secrets.token_urlsafe(48))")
CUTLY_SESSION_SECRET=cambia-esto
# Límite de subida por archivo (bytes). Por defecto 40 GB.
CUTLY_MAX_UPLOAD_BYTES=42949672960
CUTLY_UPLOAD_CHUNK_BYTES=33554432
# Transcripción: tiny|small|medium|large-v3 ; cpu|cuda ; int8|float16
CUTLY_WHISPER_MODEL=small
CUTLY_WHISPER_DEVICE=cpu
CUTLY_WHISPER_COMPUTE=int8
# Selección de clips (Anthropic)
ANTHROPIC_API_KEY=
CUTLY_CANDIDATES_MODEL=claude-opus-5-5
CUTLY_CANDIDATES_FALLBACK_MODEL=claude-opus-4-8
CUTLY_CANDIDATES_EFFORT=high
# Render: libx264 o h264_nvenc
CUTLY_VIDEO_ENCODER=libx264
# Limpieza automática (días; 0 = desactivada)
CUTLY_RETENTION_ORIGINALS_DAYS=0
CUTLY_RETENTION_PROXIES_DAYS=0
# Cloudflare solo para certbot DNS-01 (Fase 3). Token con permiso Zone:DNS:Edit únicamente.
CLOUDFLARE_API_TOKEN=
