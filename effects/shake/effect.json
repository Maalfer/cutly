{
  "name": "shake",
  "render_backend": "ffmpeg",
  "fidelity": "exact",
  "preview_fidelity": "approximate",
  "title": "Vibración de cámara",
  "category": "cámara",
  "tags": [
    "vibración",
    "temblor",
    "impacto",
    "shake"
  ],
  "description": "Sacudida de cámara para golpes, sorpresas o momentos de tensión. Recorta ligeramente la imagen mientras dura.",
  "params_schema": {
    "type": "object",
    "properties": {
      "intensity": {
        "type": "number",
        "minimum": 0.003,
        "maximum": 0.06,
        "default": 0.02,
        "description": "Amplitud como fracción del ancho (0.01 sutil, 0.03 fuerte)"
      },
      "frequency": {
        "type": "number",
        "minimum": 2,
        "maximum": 30,
        "default": 14,
        "description": "Sacudidas por segundo"
      },
      "envelope": {
        "type": "string",
        "enum": [
          "pulse",
          "in_out",
          "decay",
          "hold",
          "ramp"
        ],
        "default": "in_out",
        "description": "Forma de la intensidad en el tiempo: pulse (sube y baja suave), in_out (rampas), decay (golpe que se apaga), hold (constante), ramp (crece)"
      },
      "attack": {
        "type": "number",
        "minimum": 0.02,
        "maximum": 3,
        "default": 0.08,
        "description": "Segundos de subida (in_out)"
      },
      "release": {
        "type": "number",
        "minimum": 0.02,
        "maximum": 3,
        "default": 0.25,
        "description": "Segundos de bajada (in_out)"
      }
    }
  }
}
