# cutly versiona METODOLOGÍA (docs, scripts, plantillas, glosario, fuente), nunca material de un vídeo concreto.
# Todo lo de un vídeo (fuentes, transcripciones, planes, subtítulos, registros de toma y de cortes, clips) vive
# solo en local, en las carpetas de trabajo de abajo.

# Carpetas de trabajo (locales): se conserva solo la carpeta vacía
editor/crudo/*
!editor/crudo/.gitkeep
editor/videos-editados/*
!editor/videos-editados/.gitkeep

# Material de un vídeo concreto, esté donde esté
*_transcripcion.*
*.subtitulos.json
*.candidatos.json
material.json
*.steps.jsonl
*.mapa.md
*.fusion.md
fusion_plan.json
_cortes.log

# Vídeo y audio
*.mp4
*.mkv
*.mov
*.webm
*.avi
*.m4v
*.wav
*.mp3
*.m4a
*.part
*.ytdl

# Modelos Whisper (viven en ~/.whisper-models o en la caché de Hugging Face, nunca en el repo)
*.bin

# Sistema / editores
.DS_Store
**/.DS_Store
*.swp
__pycache__/
*.pyc

# Claude Code: solo se versionan las skills del proyecto
.claude/*.lock
.claude/settings.local.json
